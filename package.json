{
  "name": "aptos-docs-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "pnpm build:middleware-matcher && pnpm build:middleware",
    "predev": "pnpm build:middleware-matcher && pnpm build:middleware --watch &",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm prebuild && astro build && pnpm build:collapse-csp && pnpm build:generate-middleware-function",
    "build:middleware-matcher": "tsx ./scripts/generate-middleware-matcher.js",
    "build:middleware": "tsx ./scripts/generate-middleware.js",
    "build:collapse-csp": "node ./scripts/finalize-vercel-output.mjs",
    "build:generate-middleware-function": "tsx ./scripts/generate-middleware-function.js",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:search": "tsx ./scripts/check-search.ts",
    "check:links": "bash -c 'set -o pipefail; pnpm build 2>&1 | tee build-link-check.log; build_status=${PIPESTATUS[0]}; node scripts/report-broken-links.mjs build-link-check.log; report_status=$?; if [ \"$build_status\" -ne 0 ]; then exit \"$build_status\"; fi; exit \"$report_status\"'",
    "prepush": "astro check --noSync && pnpm check:links",
    "sync": "astro sync",
    "lint": "pnpm run --parallel --filter='.' /^lint:*/",
    "lint:biome": "biome check .",
    "lint:prettier": "prettier --check \"**/*.astro\"",
    "format": "pnpm run --parallel --filter='.' /^format:*/",
    "format:biome": "biome check --fix .",
    "format:prettier": "prettier --write \"**/*.astro\"",
    "format:content": "remark \"src/content/**/*.{md,mdx}\" --output",
    "postinstall": "pnpm exec simple-git-hooks",
    "tools:audit-sidebar": "tsx scripts/audit-sidebar.ts",
    "tools:fix-i18n-links": "tsx ./scripts/fix-i18n-links/fix-i18n-links-launcher.cjs",
    "test": "vitest run",
    "test:mermaid": "vitest run tests/mermaid-rendering.test.ts"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/node": "11.1.7",
    "@astrojs/partytown": "2.1.8",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@astrojs/starlight-docsearch": "0.8.0",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@astrojs/vercel": "11.0.14",
    "@firebase/app": "0.16.3",
    "@firebase/auth": "1.13.7",
    "@nanostores/react": "1.1.0",
    "@octokit/core": "7.0.8",
    "@octokit/graphql": "9.0.5",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/edge": "1.3.3",
    "@vercel/og": "0.9.0",
    "@vercel/speed-insights": "1.3.1",
    "astro": "7.3.8",
    "astro-mermaid": "2.1.0",
    "class-variance-authority": "0.7.1",
    "jose": "6.2.12",
    "lucide-react": "0.577.0",
    "mermaid": "11.16.1",
    "nanostores": "1.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.2",
    "starlight-image-zoom": "0.16.1",
    "starlight-links-validator": "0.27.0",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.2",
    "@biomejs/biome": "2.5.15",
    "@codecov/vite-plugin": "2.0.1",
    "@crowdin/cli": "4.15.0",
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "@graphiql/toolkit": "0.12.1",
    "@iconify-json/ph": "1.2.2",
    "@readme/openapi-parser": "5.5.0",
    "@scalar/api-client": "2.43.0",
    "@scalar/snippetz": "0.10.8",
    "@swc/core": "1.16.18",
    "@tailwindcss/vite": "4.3.3",
    "@types/gtag.js": "0.0.20",
    "@types/node": "25.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/turndown": "5.0.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vercel/node": "5.9.8",
    "astro-embed": "0.14.0",
    "astro-favicons": "3.1.8",
    "astro-icon": "1.2.0",
    "astro-seo-schema": "7.0.0",
    "baseline-browser-mapping": "2.11.28",
    "fast-glob": "3.3.3",
    "github-slugger": "2.0.0",
    "graphiql": "5.4.0",
    "gray-matter": "4.0.3",
    "katex": "0.19.0",
    "kleur": "4.1.5",
    "mdast-util-to-string": "4.0.0",
    "nano-staged": "0.9.0",
    "openapi-types": "12.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "satori-html": "0.3.2",
    "schema-dts": "1.1.5",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "simple-git-hooks": "2.14.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-openapi": "0.27.0",
    "starlight-package-managers": "0.13.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unist-util-remove": "4.0.0",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vite-plugin-monaco-editor": "1.1.0",
    "vitest": "4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged",
    "pre-push": "pnpm prepush"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,jsx,ts,mts,tsx,json}": [
      "biome check --fix --no-errors-on-unmatched"
    ],
    "*.astro": [
      "prettier --write"
    ],
    "src/content/**/*.mdx": [
      "remark --output --"
    ]
  }
}
