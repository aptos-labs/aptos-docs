---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import FallbackContentNotice from "@astrojs/starlight/components/FallbackContentNotice.astro";
import OverviewOperationTag from "starlight-openapi/components/overview/OverviewOperationTag.astro";
import OverviewSchema from "starlight-openapi/components/overview/OverviewSchema.astro";
import { ensureSchemaDereference } from "starlight-openapi/libs/dereference";
import {
  getSchemaStaticPaths,
  type StarlightOpenAPIRouteProps,
} from "starlight-openapi/libs/route";
import { getPageProps } from "starlight-openapi/libs/starlight";
import type { InferGetStaticPropsType } from "astro";

import Operation from "./operation/Operation.astro";
import OperationScalarModal from "./operation/OperationExamples/OperationScalarModal.astro";

export const prerender = true;

export function getStaticPaths() {
  return getSchemaStaticPaths();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths> & StarlightOpenAPIRouteProps;

const props = Astro.props as Props;
const { schema, type } = props;

await ensureSchemaDereference(schema);

const isSchemaOverview = type === "schema-overview";
const isOperationTagOverview = type === "operation-tag-overview";

const title = isSchemaOverview || isOperationTagOverview ? "Overview" : props.operation.title;
---

<StarlightPage
  {...getPageProps(
    title,
    schema,
    isSchemaOverview || isOperationTagOverview ? undefined : props.operation,
    isOperationTagOverview ? props.tag : undefined,
  )}
>
  {Astro.currentLocale !== "en" && <FallbackContentNotice />}
  {
    isSchemaOverview ? (
      <OverviewSchema {schema} />
    ) : isOperationTagOverview ? (
      <OverviewOperationTag {schema} tag={props.tag} />
    ) : (
      <Operation {schema} operation={props.operation} />
    )
  }
</StarlightPage>
<!-- StarlightPage creates a stacking context that breaks modal styles -->
<OperationScalarModal />
